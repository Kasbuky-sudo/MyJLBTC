/**
 * 更新日志（关于页 → 更新日志）。
 * 每个版本一条：版本号 + 日期 + 变更条目（新增/修复/优化混排，按条目型书写）。
 * 新版本往数组头部加。
 */
export class ChangelogEntry {
  version: string;
  date: string;
  items: string[];

  constructor(version: string, date: string, items: string[]) {
    this.version = version;
    this.date = date;
    this.items = items;
  }
}

