<?xml version="1.0" encoding="utf-8"?>
<!-- 今日课程卡片（4×2 单课卡 / 4×4 今日列表共用一套版式）：
     头部「第 N 周 · 周X」+ 节次角标；每行 = 左侧课程色条 + 课名/地点·教师 + 起止时刻。 -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="16dp"
    android:background="@drawable/widget_bg">

    <!-- 空态：今日无课 / 课表未同步 -->
    <LinearLayout
        android:id="@+id/widget_empty"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:gravity="center"
        android:visibility="gone">

        <TextView
            android:id="@+id/widget_empty_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="18sp"
            android:textStyle="bold"
            android:textColor="@color/widget_text_primary"
            android:text="@string/widget_no_course" />

        <TextView
            android:id="@+id/widget_empty_tip"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:textSize="12sp"
            android:textColor="@color/widget_text_secondary"
            android:text="@string/widget_no_course_tip" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/widget_body"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <!-- 头部：第 16 周 · 周五 +（节次 / 门数）角标 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:id="@+id/widget_head"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:textSize="13sp"
                android:textStyle="bold"
                android:textColor="@color/widget_text_primary"
                android:maxLines="1"
                android:ellipsize="end" />

            <TextView
                android:id="@+id/widget_badge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:minWidth="20dp"
                android:gravity="center"
                android:paddingStart="6dp"
                android:paddingEnd="6dp"
                android:paddingTop="2dp"
                android:paddingBottom="2dp"
                android:background="@drawable/widget_badge"
                android:textSize="10.5sp"
                android:textStyle="bold"
                android:textColor="@color/widget_accent" />
        </LinearLayout>

    <!-- 第 1 行：色条 + 课名/地点·教师 + 起止时刻（版式对齐 WakeUp 今日课程卡片） -->
    <LinearLayout
        android:id="@+id/widget_row0"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginTop="6dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:padding="8dp"
        android:background="@drawable/widget_row_plain">

        <TextView
            android:id="@+id/widget_bar0"
            android:layout_width="3dp"
            android:layout_height="match_parent"
            android:background="@drawable/widget_bar_1" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="8dp"
            android:orientation="vertical">

            <TextView
                android:id="@+id/widget_name0"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textSize="15sp"
                android:textStyle="bold"
                android:textColor="@color/widget_text_primary"
                android:maxLines="1"
                android:ellipsize="end" />

            <TextView
                android:id="@+id/widget_meta0"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:textSize="11.5sp"
                android:textColor="@color/widget_text_secondary"
                android:maxLines="1"
                android:ellipsize="end" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:orientation="vertical"
            android:gravity="end">

            <TextView
                android:id="@+id/widget_start0"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="12.5sp"
                android:textStyle="bold"
                android:textColor="@color/widget_accent" />

            <TextView
                android:id="@+id/widget_end0"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="1dp"
                android:textSize="11sp"
                android:textColor="@color/widget_text_secondary" />
        </LinearLayout>
    </LinearLayout>

    <!-- 第 2 行：色条 + 课名/地点·教师 + 起止时刻（版式对齐 WakeUp 今日课程卡片） -->
    <LinearLayout
        android:id="@+id/widget_row1"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginTop="6dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:padding="8dp"
        android:background="@drawable/widget_row_plain">

        <TextView
            android:id="@+id/widget_bar1"
            android:layout_width="3dp"
            android:layout_height="match_parent"
            android:background="@drawable/widget_bar_1" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="8dp"
            android:orientation="vertical">

            <TextView
                android:id="@+id/widget_name1"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textSize="15sp"
                android:textStyle="bold"
                android:textColor="@color/widget_text_primary"
                android:maxLines="1"
                android:ellipsize="end" />

            <TextView
                android:id="@+id/widget_meta1"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:textSize="11.5sp"
                android:textColor="@color/widget_text_secondary"
                android:maxLines="1"
                android:ellipsize="end" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:orientation="vertical"
            android:gravity="end">

            <TextView
                android:id="@+id/widget_start1"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="12.5sp"
                android:textStyle="bold"
                android:textColor="@color/widget_accent" />

            <TextView
                android:id="@+id/widget_end1"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="1dp"
                android:textSize="11sp"
                android:textColor="@color/widget_text_secondary" />
        </LinearLayout>
    </LinearLayout>

    <!-- 第 3 行：色条 + 课名/地点·教师 + 起止时刻（版式对齐 WakeUp 今日课程卡片） -->
    <LinearLayout
        android:id="@+id/widget_row2"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginTop="6dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:padding="8dp"
        android:background="@drawable/widget_row_plain">

        <TextView
            android:id="@+id/widget_bar2"
            android:layout_width="3dp"
            android:layout_height="match_parent"
            android:background="@drawable/widget_bar_1" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="8dp"
            android:orientation="vertical">

            <TextView
                android:id="@+id/widget_name2"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textSize="15sp"
                android:textStyle="bold"
                android:textColor="@color/widget_text_primary"
                android:maxLines="1"
                android:ellipsize="end" />

            <TextView
                android:id="@+id/widget_meta2"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:textSize="11.5sp"
                android:textColor="@color/widget_text_secondary"
                android:maxLines="1"
                android:ellipsize="end" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:orientation="vertical"
            android:gravity="end">

            <TextView
                android:id="@+id/widget_start2"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="12.5sp"
                android:textStyle="bold"
                android:textColor="@color/widget_accent" />

            <TextView
                android:id="@+id/widget_end2"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="1dp"
                android:textSize="11sp"
                android:textColor="@color/widget_text_secondary" />
        </LinearLayout>
    </LinearLayout>

    <!-- 第 4 行：色条 + 课名/地点·教师 + 起止时刻（版式对齐 WakeUp 今日课程卡片） -->
    <LinearLayout
        android:id="@+id/widget_row3"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginTop="6dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:padding="8dp"
        android:background="@drawable/widget_row_plain">

        <TextView
            android:id="@+id/widget_bar3"
            android:layout_width="3dp"
            android:layout_height="match_parent"
            android:background="@drawable/widget_bar_1" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="8dp"
            android:orientation="vertical">

            <TextView
                android:id="@+id/widget_name3"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textSize="15sp"
                android:textStyle="bold"
                android:textColor="@color/widget_text_primary"
                android:maxLines="1"
                android:ellipsize="end" />

            <TextView
                android:id="@+id/widget_meta3"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:textSize="11.5sp"
                android:textColor="@color/widget_text_secondary"
                android:maxLines="1"
                android:ellipsize="end" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:orientation="vertical"
            android:gravity="end">

            <TextView
                android:id="@+id/widget_start3"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="12.5sp"
                android:textStyle="bold"
                android:textColor="@color/widget_accent" />

            <TextView
                android:id="@+id/widget_end3"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="1dp"
                android:textSize="11sp"
                android:textColor="@color/widget_text_secondary" />
        </LinearLayout>
    </LinearLayout>
    </LinearLayout>
</LinearLayout>
